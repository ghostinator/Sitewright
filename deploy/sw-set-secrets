#!/bin/bash
# Prompts (hidden input for secrets) and stores integration settings in /srv/sitewright/config/config.php. Nothing is echoed or logged.
#   sudo sw-set-secrets postal      Postal HTTP API (url + server API key + from address)
#   sudo sw-set-secrets mail        Generic SMTP server
#   sudo sw-set-secrets teams       Microsoft Teams Workflows webhook URL
#   sudo sw-set-secrets telegram    Telegram bot token + chat id
#   sudo sw-set-secrets google      Google OAuth client id + secret (Search Console)
#   sudo sw-set-secrets gemini      Gemini API key
#   sudo sw-set-secrets show        Print which settings are present (never their values)
#   sudo sw-set-secrets clear <mail|teams|telegram|google|gemini>
set -euo pipefail
[ "$(id -u)" = 0 ] || [ -n "${SW_SECRETS_TEST:-}" ] || { echo "run with sudo"; exit 1; }
CFG="${SW_CFG:-/srv/sitewright/config/config.php}"
ask()  { local v; read -r -p "$1: " v; printf '%s' "${v//[$'\r\n']/}"; }
askh() { local v; read -r -s -p "$1 (hidden): " v; echo >&2; printf '%s' "$(printf '%s' "$v" | tr -d '[:space:]')"; }
askp() { local v; read -r -s -p "$1 (hidden): " v; echo >&2; printf '%s' "${v//[$'\r\n']/}"; }   # passwords: keep spaces
bad()  { echo "Rejected: $1" >&2; exit 1; }
set_cfg() {  # args: json object to merge (read from env SW_PATCH)
  SW_CFG_FILE="$CFG" php -r '
    $f = getenv("SW_CFG_FILE"); $c = is_file($f) ? require $f : [];
    $p = json_decode(getenv("SW_PATCH"), true);
    $c = array_replace_recursive($c, $p);
    foreach (($argv[1] ?? "") === "clear" ? json_decode(getenv("SW_CLEAR"), true) : [] as $path) { $r =& $c; $parts = explode(".", $path); $last = array_pop($parts); foreach ($parts as $k) { $r =& $r[$k]; } $r[$last] = is_array($r[$last] ?? null) ? [] : ""; unset($r); }
    file_put_contents($f, "<?php\n// Staging deployment config. Keep private (0640 sitewright:www-data).\nreturn " . var_export($c, true) . ";\n");' "${1:-}"
  if [ -z "${SW_SECRETS_TEST:-}" ]; then chown sitewright:www-data "$CFG"; chmod 640 "$CFG"; systemctl reload php8.4-fpm 2>/dev/null || true; systemctl restart sitewright-worker 2>/dev/null || true; fi
}
patch() { SW_PATCH="$1" set_cfg; }
case "${1:-}" in
  postal)
    url=$(ask "Postal URL [https://app.ghosties.email]"); url=${url:-https://app.ghosties.email}
    key=$(askh "Postal server API key"); from=$(ask "From address (domain must be verified in Postal)"); name=$(ask "From name [Sitewright]"); name=${name:-Sitewright}
    [[ "$url" =~ ^https://[A-Za-z0-9.-]+(:[0-9]+)?(/[A-Za-z0-9._~/-]*)?$ ]] || bad "url"; [[ "$key" =~ ^[[:graph:]]{8,200}$ ]] || bad "key"
    [[ "$from" =~ ^[^[:space:]@]+@[^[:space:]@]+$ ]] || bad "from address"; [[ "$name" != *$'\n'* ]] || bad "name"
    SW_PATCH=$(U="$url" K="$key" F="$from" N="$name" php -r 'echo json_encode(["mail"=>["driver"=>"postal","postal_url"=>getenv("U"),"postal_key"=>getenv("K"),"from"=>getenv("F"),"from_name"=>getenv("N")]]);') set_cfg
    echo "Postal API settings stored. Test: cd /srv/sitewright && sudo -u www-data php bin/alert-test.php" ;;
  mail)
    host=$(ask "SMTP host"); port=$(ask "SMTP port [587]"); port=${port:-587}
    enc=$(ask "Encryption: starttls | tls | none [starttls]"); enc=${enc:-starttls}
    user=$(ask "SMTP username"); pass=$(askp "SMTP password")
    from=$(ask "From address"); name=$(ask "From name [Sitewright]"); name=${name:-Sitewright}
    [[ "$host" =~ ^[A-Za-z0-9._-]+$ ]] || bad "host"; [[ "$port" =~ ^[0-9]{1,5}$ ]] || bad "port"
    [[ "$enc" =~ ^(starttls|tls|none)$ ]] || bad "encryption"; [[ "$from" =~ ^[^[:space:]@]+@[^[:space:]@]+$ ]] || bad "from address"
    [[ "$name" != *$'\n'* ]] || bad "name"
    SW_PATCH=$(H="$host" P="$port" E="$enc" U="$user" W="$pass" F="$from" N="$name" php -r 'echo json_encode(["mail"=>["host"=>getenv("H"),"port"=>(int)getenv("P"),"encryption"=>getenv("E"),"username"=>getenv("U"),"password"=>getenv("W"),"from"=>getenv("F"),"from_name"=>getenv("N")]]);') set_cfg
    echo "Mail settings stored. Test: cd /srv/sitewright && sudo -u www-data php bin/alert-test.php" ;;
  teams)
    url=$(askh "Teams webhook URL"); [[ "$url" =~ ^https://[A-Za-z0-9.-]+/[^[:space:]\"\'\\]+$ ]] || bad "expected an https:// URL"
    SW_PATCH=$(U="$url" php -r 'echo json_encode(["alerts"=>["teams_webhook"=>getenv("U")]]);') set_cfg; echo "Teams webhook stored." ;;
  telegram)
    tok=$(askh "Telegram bot token"); chat=$(ask "Telegram chat id")
    [[ "$tok" =~ ^[0-9A-Za-z:_-]{10,100}$ ]] || bad "token format"; [[ "$chat" =~ ^-?[0-9]{3,20}$ ]] || bad "chat id (digits, may start with -)"
    SW_PATCH=$(T="$tok" C="$chat" php -r 'echo json_encode(["alerts"=>["telegram_token"=>getenv("T"),"telegram_chat_id"=>getenv("C")]]);') set_cfg; echo "Telegram settings stored." ;;
  google)
    id=$(ask "Google OAuth client id"); sec=$(askh "Google OAuth client secret"); redir=$(ask "Redirect URI (https://…/api/gsc/callback)")
    [[ "$id" =~ ^[A-Za-z0-9._-]{10,200}$ ]] || bad "client id"; [[ "$sec" =~ ^[[:graph:]]{10,200}$ ]] || bad "client secret"; [[ "$redir" =~ ^https://[^[:space:]]+/api/gsc/callback$ ]] || bad "redirect URI"
    SW_PATCH=$(I="$id" S="$sec" R="$redir" php -r 'echo json_encode(["google"=>["client_id"=>getenv("I"),"client_secret"=>getenv("S"),"redirect_uri"=>getenv("R")]]);') set_cfg; echo "Google OAuth client stored." ;;
  gemini)
    key=$(askh "Gemini API key"); [[ "$key" =~ ^[[:graph:]]+$ ]] && [ ${#key} -ge 16 ] && [ ${#key} -le 256 ] && [[ "$key" != *[\'\"\\]* ]] || bad "key format"
    SW_PATCH=$(K="$key" php -r 'echo json_encode(["gemini"=>["api_key"=>getenv("K")]]);') set_cfg; echo "Gemini key stored." ;;
  show)
    SW_CFG_FILE="$CFG" php -r '$c = is_file(getenv("SW_CFG_FILE")) ? require getenv("SW_CFG_FILE") : []; $has = fn($v) => $v !== null && $v !== "" && $v !== [] ? "set" : "-";
      foreach (["mail host"=>$c["mail"]["host"]??"", "postal key"=>$c["mail"]["postal_key"]??"", "mail password"=>$c["mail"]["password"]??"", "alert emails"=>$c["alerts"]["email_to"]??[], "teams webhook"=>$c["alerts"]["teams_webhook"]??"", "telegram token"=>$c["alerts"]["telegram_token"]??"", "telegram chat"=>$c["alerts"]["telegram_chat_id"]??"", "google client"=>$c["google"]["client_id"]??"", "google secret"=>$c["google"]["client_secret"]??"", "gemini key"=>$c["gemini"]["api_key"]??"", "app key"=>$c["app_key"]??""] as $k=>$v) printf("%-16s %s\n", $k, $has($v));' ;;
  alert-emails)
    to=$(ask "Alert e-mail address(es), comma separated"); SW_PATCH=$(T="$to" php -r 'echo json_encode(["alerts"=>["email_to"=>array_values(array_filter(array_map("trim", explode(",", getenv("T")))))]]);') set_cfg; echo stored ;;
  clear)
    case "${2:-}" in
      mail|postal) paths='["mail.host","mail.username","mail.password","mail.from","mail.postal_url","mail.postal_key"]' ;; teams) paths='["alerts.teams_webhook"]' ;;
      telegram) paths='["alerts.telegram_token","alerts.telegram_chat_id"]' ;; google) paths='["google.client_id","google.client_secret","google.redirect_uri"]' ;;
      gemini) paths='["gemini.api_key"]' ;; *) bad "unknown group" ;;
    esac
    SW_PATCH='{}' SW_CLEAR="$paths" set_cfg clear; echo "Cleared ${2}." ;;
  *) sed -n '2,10p' "$0"; exit 2 ;;
esac
